# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string. Locally a Postgres you run yourself; in
# production the Neon connection string from the Vercel project.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agro"

# A separate, throwaway database for `npm test`. The tests empty every table.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/agro_test"

# Used only by `npm run db:seed` to create the first two users.
# Phone: Bangladeshi mobile number, for example 017XXXXXXXX.
SEED_OWNER_NAME=""
SEED_OWNER_PHONE=""
SEED_OWNER_PASSWORD=""
SEED_MANAGER_NAME=""
SEED_MANAGER_PHONE=""
SEED_MANAGER_PASSWORD=""
